//@version=6
indicator("System+ V4.2", overlay = true, max_bars_back = 600,
     max_lines_count = 500, max_labels_count = 500)

// System+ V4.2, Stand 27.10.2026
// Gates: Pivot-Box 3/3 (Hoehe max 3 ATR), erster Close ueber Oberkante,
// Close > SMA10, ATR % 4.5-10, 52W 10-30 % unter Hoch,
// Umsatz-YoY letztes Quartal > Umsatz-YoY Quartal davor.
// Notbremse QQQE sperrt nicht mehr: bei aktiver Notbremse 0.5 % statt 1 % Risiko.
// Universum (TV-Screener): Kurs > 5, Market Cap > 300 Mio, Volumen 30T > 1 Mio, Float > 70 %.
// Exits M2: SL = SMA10 Entry-Tag, vor 1R Close < SMA10 alles raus,
// ab 1R Close < SMA10 40 %, Close < SMA20 Rest.
// Close < SMA20 gilt auch vor 1R (liegt die SMA20 ueber der SMA10, geht dort alles raus).
// Backtest 29.10.2026: besser als SMA20 erst ab 1R/TP1 oder kein Entry unter SMA20.
// Max. 3 Neukaeufe pro Tag ist eine Konto-Regel (nicht im Chart pruefbar).

// ---------- Eingaben ----------
const string GB = "Pivot-Box"
int pivLen = input.int(3, "Pivot-Laenge", minval = 1, group = GB)
float maxBoxAtr = input.float(3.0, "Max. Box-Hoehe (x ATR)", step = 0.1, group = GB)
int atrLen = input.int(14, "ATR-Laenge", group = GB)

const string GG = "Entry-Gates"
float atrPctMin = input.float(4.5, "Min. ATR %", step = 0.1, group = GG)
float atrPctMax = input.float(10.0, "Max. ATR %", step = 0.5, group = GG)
float w52Min = input.float(10.0, "52W min. % unter Hoch", step = 0.5, group = GG)
float w52Max = input.float(30.0, "52W max. % unter Hoch", step = 1, group = GG)
bool useCB = input.bool(true, "Notbremse", group = GG)
string cbSym = input.symbol("NASDAQ:QQQE", "Notbremse-Index", group = GG)
string cbMode = input.string("Risiko reduzieren", "Bei aktiver Notbremse",
     options = ["Risiko reduzieren", "kein Entry"], group = GG)
float cbRiskPct = input.float(0.5, "Risiko % bei Notbremse", step = 0.25, group = GG)
bool useRev = input.bool(true, "Umsatz beschleunigt", group = GG)
string revMiss = input.string("kein Entry", "Ohne Umsatzdaten",
     options = ["kein Entry", "zulassen"], group = GG)
bool onePos = input.bool(true, "Nur eine Position je Titel", group = GG)
int postEarnMax = input.int(5, "Hinweis: Breakout bis x Tage nach Earnings", minval = 0, group = GG,
     tooltip = "Nur Markierung, kein Gate. Backtest 2019-2026: 0-5 Tage nach Earnings -0.03 R, Rest +0.38 R")

const string GT = "Trade-Management"
float acct = input.float(10000, "Kontogroesse", step = 1000, group = GT)
float riskPct = input.float(1.0, "Risiko % pro Trade", step = 0.25, group = GT)
float capPct = input.float(15.0, "Max. Position % Konto", options = [10.0, 15.0, 20.0], group = GT)
string stopMode = input.string("Intraday", "Stop-Ausloesung",
     options = ["Intraday", "EOD"], group = GT)
int fastLen = input.int(10, "Fast MA (SL/TP1)", group = GT)
int slowLen = input.int(20, "Slow MA (TP2)", group = GT)
bool showMAs = input.bool(false, "MAs zeigen", group = GT)

const string GD = "Anzeige"
bool showTable = input.bool(true, "Tabelle", group = GD)
string tblPos = input.string("Unten rechts", "Tabellen-Position",
     options = ["Unten rechts", "Oben rechts", "Unten links", "Oben links"], group = GD)
string tblSize = input.string("Klein", "Schrift",
     options = ["Winzig", "Klein", "Normal"], group = GD)
bool showFails = input.bool(true, "Gesperrte Breakouts markieren", group = GD)
bool showMaWarn = input.bool(true, "Warnung: intraday unter Exit-MA", group = GD,
     tooltip = "Rotes Dreieck (hell) ueber der Kerze, solange der aktuelle Kurs einer offenen Position unter der Exit-MA liegt: bis TP1 die hoehere von SMA10/SMA20, danach SMA20. Schliesst die Kerze wieder darueber, verschwindet es.")
int showClosed = input.int(5, "Geschlossenen Trade im Status zeigen (Kerzen)", minval = 0, group = GD)
bool showGates = input.bool(false, "Gate-Werte als eigene Zeilen", group = GD,
     tooltip = "Aus: eine Zeile Gates (ok oder Sperrgrund), Werte im Tooltip. An: ATR, 52W und Umsatz zusaetzlich als Zeilen.")

// ---------- Grundgroessen ----------
float atr = ta.atr(atrLen)
float sma10 = ta.sma(close, fastLen)
float sma20 = ta.sma(close, slowLen)
float hi252 = ta.highest(high, 252)
float off52 = 100 * (close / hi252 - 1)
float atrPct = 100 * atr / close
float atrMult = (close - sma10) / atr   // Rangfolge bei mehreren Entries: niedrigster Wert zuerst

// ---------- Pivot-Box (wie System+ v3.8) ----------
float pvH = ta.pivothigh(high, pivLen, pivLen)
float pvL = ta.pivotlow(low, pivLen, pivLen)
var float pTop = na
var float pBot = na
var int pTopBar = na
var int pBotBar = na
var int pUsedBar = na
if not na(pvH)
    pTop := pvH
    pTopBar := bar_index - pivLen
if not na(pvL)
    pBot := pvL
    pBotBar := bar_index - pivLen
float boxH = (pTop - pBot) / atr[1]
bool hasBox = not na(pTop) and not na(pBot) and pBot < pTop
bool boxUsed = pTopBar == pUsedBar
bool boxValid = hasBox and boxH <= maxBoxAtr and not boxUsed
bool brk = boxValid and close > pTop and close[1] <= pTop

// ---------- Notbremse ----------
[qC, qE200, qHi60, qS200, qS200p] = request.security(cbSym, "D",
     [close, ta.ema(close, 200), ta.highest(close, 60), ta.sma(close, 200),
     ta.sma(close, 200)[20]], lookahead = barmerge.lookahead_off)
float qDD = 100 * (qC / qHi60 - 1)
bool qSlopeDn = qS200 < qS200p
bool cbOn = useCB and (qC < qE200 or qDD <= -10 or qSlopeDn)
string cbName = syminfo.ticker(cbSym)

// ---------- Umsatz beschleunigt ----------
// TradingView ordnet Quartalswerte in der Historie dem Quartalsende zu. Ein neuer Wert
// zaehlt deshalb erst ab dem naechsten Earnings-Termin (spaetestens nach 70 Kerzen).
float rev = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ",
     barmerge.gaps_off, ignore_invalid_symbol = true)
float revRep = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on,
     ignore_invalid_symbol = true)
var array<float> rq = array.new<float>()
var float revSeen = na
var float revPend = na
var int pendBar = na
var int repBar = na
var int repT = na
var int revChgT = na
if not na(revRep)
    repBar := bar_index
    repT := time
if not na(rev) and (na(revSeen) or rev != revSeen)
    revSeen := rev
    revChgT := time
    bool justRep = not na(repBar) and bar_index - repBar <= 10
    if rq.size() == 0 or justRep
        rq.push(rev)
        revPend := na
    else
        revPend := rev
        pendBar := bar_index
if not na(revPend)
    bool repAfter = not na(revRep) and bar_index > pendBar
    if repAfter or bar_index - pendBar >= 70
        rq.push(revPend)
        revPend := na
if rq.size() > 8
    rq.shift()
int nq = rq.size()
float yoy0 = na
float yoy1 = na
if nq >= 5
    float b0 = rq.get(nq - 5)
    yoy0 := b0 > 0 ? 100 * (rq.get(nq - 1) / b0 - 1) : na
if nq >= 6
    float b1 = rq.get(nq - 6)
    yoy1 := b1 > 0 ? 100 * (rq.get(nq - 2) / b1 - 1) : na
bool revKnown = not na(yoy0) and not na(yoy1)
bool revAccel = revKnown and yoy0 > yoy1
bool revOk = not useRev or revAccel or (not revKnown and revMiss == "zulassen")

// ---------- Letzte Earnings (Meldetag) ----------
float eAct = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on,
     ignore_invalid_symbol = true)
var int lastEarnBar = na
var int lastEarnTime = na
if not na(eAct)
    lastEarnBar := bar_index
    lastEarnTime := time
int sinceEarn = na(lastEarnBar) ? na : bar_index - lastEarnBar
bool postEarn = not na(sinceEarn) and sinceEarn <= postEarnMax
string postTxt = postEarn ? " | NACH EARNINGS (" + str.tostring(sinceEarn) + " T)" : ""

// ---------- Gates ----------
bool aboveMa = close > sma10
bool atrOk = atrPct >= atrPctMin and atrPct <= atrPctMax
bool w52Ok = not na(off52) and off52 <= -w52Min and off52 >= -w52Max
bool cbBlock = cbOn and cbMode == "kein Entry"
bool cbOk = not cbBlock
float riskNow = cbOn and not cbBlock ? cbRiskPct : riskPct
string riskTxt = str.tostring(riskNow, "0.0#") + " %"

f_why() =>
    string w = ""
    if not atrOk
        w := atrPct < atrPctMin ? "ATR % zu klein" : "ATR % zu gross"
    else if not w52Ok
        w := na(off52) ? "52W Historie" : off52 > -w52Min ? "zu nah am 52W-Hoch" : "zu weit unter 52W-Hoch"
    else if not cbOk
        w := "Notbremse"
    else if not revOk
        w := revKnown ? "Umsatz nicht beschleunigt" : "keine Umsatzdaten"
    w

f_shares(float entry, float stop) =>
    float r = entry - stop
    float byRisk = acct * riskNow / 100 / r
    float byCap = acct * capPct / 100 / entry
    r > 0 ? math.floor(math.min(byRisk, byCap) * 10) / 10 : 0.0

f_sgn(float v, string fmt) =>
    (v >= 0 ? "+" : "") + str.tostring(v, fmt)

// ---------- Trade (M2) ----------
type Trade
    int bar
    int t
    float entry
    float stop
    float risk
    float shares
    float rem = 1.0
    float rSum = 0.0
    float pSum = 0.0
    bool r1 = false
    bool tp1 = false
    string lastTag = ""
    line slLn
    line enLn
    line r1Ln

var Trade tr = na
var int nT = 0
var int nW = 0
var float sumR = 0.0
var float sumP = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float sumUsd = 0.0
var int lastExitBar = na
var int lastExitT = na
var float lastExitR = na
var float lastExitP = na
var string lastExitTag = ""

bool evalBar = barstate.ishistory or barstate.isconfirmed
bool liveBar = barstate.isrealtime and not barstate.isconfirmed
bool freeNow = not onePos or na(tr)
string why = f_why()
// Vorschau auf offener Kerze: zaehlt erst beim Close (dann entryNow)
bool entryPre = liveBar and brk and aboveMa and why == "" and freeNow
bool entryNow = false
bool exitNow = false
bool blocked = false
array<string> msgs = array.new<string>()

f_fill(Trade t, float frac, float px, string tag) =>
    float f = math.min(frac, t.rem)
    if f > 0
        t.rem := t.rem - f
        t.rSum := t.rSum + f * (px - t.entry) / t.risk
        t.pSum := t.pSum + f * 100 * (px - t.entry) / t.entry
        t.lastTag := tag
        string pctTxt = str.tostring(math.round(f * 100)) + " %"
        msgs.push(syminfo.ticker + " " + tag + " " + pctTxt + " @ " + str.tostring(px, format.mintick))
    f

// ---------- Warnung: intraday unter Exit-MA (Stand vor den Fills dieser Kerze) ----------
bool maWarn = false
float maLvl = na
string maName = ""
string maRule = ""
if not na(tr) and bar_index > tr.bar
    // bis TP1 zaehlt die hoehere MA: SMA20 ueber SMA10 -> dort geht alles raus
    bool use20 = tr.tp1 or sma20 > sma10
    maLvl := use20 ? sma20 : sma10
    maName := use20 ? "SMA20" : "SMA10"
    maRule := tr.tp1 ? "TP2 Rest" : use20 ? "Exit 100 %" : not tr.r1 ? "Fail 100 %" : "TP1 40 %"
    maWarn := showMaWarn and not na(maLvl) and close < maLvl

if evalBar
    // offene Position ab dem Tag nach dem Entry
    if not na(tr) and bar_index > tr.bar
        bool stopHit = stopMode == "EOD" ? close < tr.stop : low <= tr.stop
        if stopHit
            float px = stopMode == "EOD" ? close : math.min(open, tr.stop)
            f_fill(tr, tr.rem, px, "SL")
        else
            if not tr.r1 and high >= tr.entry + tr.risk
                tr.r1 := true
            if not tr.r1 and close < sma10
                f_fill(tr, tr.rem, close, "Fail")
            else
                if not tr.tp1 and close < sma10
                    f_fill(tr, 0.4, close, "TP1")
                    tr.tp1 := true
                if close < sma20
                    f_fill(tr, tr.rem, close, "TP2")
        line.set_x2(tr.slLn, bar_index + 3)
        line.set_x2(tr.enLn, bar_index + 3)
        line.set_x2(tr.r1Ln, bar_index + 3)
        if tr.rem <= 0.000001
            exitNow := true
            nT += 1
            nW += tr.rSum > 0 ? 1 : 0
            sumR += tr.rSum
            sumP += tr.pSum
            grossW += math.max(tr.rSum, 0)
            grossL += math.max(-tr.rSum, 0)
            sumUsd += tr.shares * tr.entry * tr.pSum / 100
            lastExitBar := bar_index
            lastExitT := time
            lastExitR := tr.rSum
            lastExitP := tr.pSum
            lastExitTag := tr.lastTag
            line.delete(tr.slLn)
            line.delete(tr.enLn)
            line.delete(tr.r1Ln)
            string res = f_sgn(tr.rSum, "0.0") + "R\n" + f_sgn(tr.pSum, "0.0") + " %"
            color rc = tr.rSum >= 0 ? color.green : color.red
            label.new(bar_index, high, res, style = label.style_label_down,
                 color = color.new(color.white, 100), textcolor = rc, size = size.tiny)
            tr := na

    // Oberkante verbraucht, sobald Close > Oberkante und Close > SMA10
    if brk and aboveMa
        pUsedBar := pTopBar
        bool free = not onePos or na(tr)
        if why == "" and free
            entryNow := true
            float risk = close - sma10
            tr := Trade.new(bar_index, time, close, sma10, risk, f_shares(close, sma10))
            // x2 = bar_index + 3: Linien schon am Entry-Tag sichtbar (vorher Laenge 0)
            tr.slLn := line.new(bar_index, sma10, bar_index + 3, sma10, color = color.red,
                 style = line.style_dashed)
            tr.enLn := line.new(bar_index, close, bar_index + 3, close, color = color.gray,
                 style = line.style_dashed)
            tr.r1Ln := line.new(bar_index, close + risk, bar_index + 3, close + risk,
                 color = color.green, style = line.style_dotted)
            string eTxt = " ENTRY " + str.tostring(close, format.mintick)
            string sTxt = " | SL " + str.tostring(sma10, format.mintick)
            string kTxt = " | Stueck " + str.tostring(tr.shares, "0.0") + " | Risiko " + riskTxt
            kTxt += " | ATR-Mult " + str.tostring(atrMult, "0.00")
            msgs.push(syminfo.ticker + eTxt + sTxt + kTxt + postTxt)
        else if why != ""
            blocked := true
            msgs.push(syminfo.ticker + " BREAKOUT gesperrt: " + why)
            if showFails
                string tip = "gesperrt: " + why + "\nATR % " + str.tostring(atrPct, "0.0")
                tip += " | 52W " + str.tostring(off52, "0.0") + " %"
                tip += "\nUmsatz YoY " + (revKnown ? str.tostring(yoy0, "0") + " % vs. "
                     + str.tostring(yoy1, "0") + " %" : "keine Daten (" + str.tostring(nq) + " Q)")
                string fT = "dd.MM.yy"
                string chgTxt = na(revChgT) ? "-" : str.format_time(revChgT, fT, syminfo.timezone)
                string repTxt = na(repT) ? "-" : str.format_time(repT, fT, syminfo.timezone)
                tip += "\nPruef: Q-Wert neu " + chgTxt + " | Earnings " + repTxt
                tip += " | wartet " + (na(revPend) ? "nein" : "ja")
                label.new(bar_index, low, "", style = label.style_circle, yloc = yloc.belowbar,
                     color = color.new(color.gray, 30), size = size.tiny, tooltip = tip)

// ---------- Zeichnen ----------
var line bTop = na
var line bBot = na
if barstate.islast
    line.delete(bTop)
    line.delete(bBot)
    if hasBox
        color bc = boxValid ? color.white : color.new(color.gray, 40)
        string bs = boxValid ? line.style_solid : line.style_dashed
        bTop := line.new(pTopBar, pTop, bar_index + 3, pTop, color = bc, style = bs)
        bBot := line.new(pBotBar, pBot, bar_index + 3, pBot, color = bc, style = bs)

plotshape(entryNow and not postEarn, "Entry", shape.triangleup, location.belowbar, color.green,
     size = size.tiny)
plotshape(entryNow and postEarn, "Entry nach Earnings", shape.triangleup, location.belowbar,
     color.orange, size = size.tiny)
plotshape(entryPre, "Entry vorlaeufig (Kerze offen)", shape.triangleup, location.belowbar,
     color.new(color.green, 55), size = size.tiny)
// Vorschau-Linien auf offener Kerze; Pine verwirft sie bei jedem Tick (Rollback) und beim Close
if entryPre
    float pRisk = close - sma10
    line.new(bar_index, sma10, bar_index + 3, sma10, color = color.new(color.red, 40),
         style = line.style_dashed)
    line.new(bar_index, close, bar_index + 3, close, color = color.new(color.gray, 40),
         style = line.style_dashed)
    line.new(bar_index, close + pRisk, bar_index + 3, close + pRisk,
         color = color.new(color.green, 40), style = line.style_dotted)
plotshape(exitNow, "Exit", shape.triangledown, location.abovebar, color.red, size = size.tiny)
plotshape(maWarn and not exitNow, "Warnung intraday unter Exit-MA", shape.triangledown,
     location.abovebar, color.new(color.red, 55), size = size.tiny)
plot(showMAs ? sma10 : na, "SMA10", color.orange)
plot(showMAs ? sma20 : na, "SMA20", color.blue)

// ---------- Tabelle (kompakt, Details im Tooltip) ----------
var table tb = na
f_row(int r, string k, string v, color c, string sz, string tip = "") =>
    table.cell(tb, 0, r, k, text_color = color.gray, text_size = sz, bgcolor = color(na),
         text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = sz, text_halign = text.align_right,
         bgcolor = color(na), tooltip = tip)
    r + 1

f_head(int r, string txt, color c, string sz, string tip = "") =>
    table.cell(tb, 0, r, txt, text_color = c, text_size = sz, text_halign = text.align_left,
         bgcolor = color(na), tooltip = tip)
    table.merge_cells(tb, 0, r, 1, r)
    r + 1

if showTable and barstate.islast
    string sz = tblSize == "Winzig" ? size.tiny : tblSize == "Normal" ? size.normal : size.small
    string ps = switch tblPos
        "Oben rechts" => position.top_right
        "Unten links" => position.bottom_left
        "Oben links" => position.top_left
        => position.bottom_right
    table.delete(tb)
    tb := table.new(ps, 2, 16, bgcolor = color(na), frame_width = 0, border_width = 0)
    color ok = color.lime
    color bad = color.red
    color neu = color.orange
    string mt = format.mintick
    int r = 0

    // Kopf: Notbremse + Risiko, Details im Tooltip
    string cbTip = cbName + " " + str.tostring(qDD, "0.0") + " % vom 60T-Hoch"
    cbTip += (qC >= qE200 ? " | ueber EMA200" : " | unter EMA200")
    cbTip += (qSlopeDn ? " | SMA200 fallend" : " | SMA200 steigt")
    string hTxt = "System+ 4.2 | " + (cbOn ? (cbBlock ? "NOTBREMSE, kein Entry" : "NOTBREMSE") : "frei")
    hTxt += " | " + str.tostring(riskNow, "0.0#") + " %"
    r := f_head(r, hTxt, cbOn ? bad : neu, sz, cbTip)

    if not na(tr)
        // ----- offene Position -----
        string since = str.format_time(tr.t, "dd.MM.", syminfo.timezone)
        string trTxt = since + " | " + str.tostring(bar_index - tr.bar) + " T | "
        trTxt += str.tostring(math.round(tr.rem * 100)) + " % offen"
        string trTip = "Entry " + str.tostring(tr.entry, mt) + " | SL " + str.tostring(tr.stop, mt)
        trTip += " | " + str.tostring(tr.shares, "0.0") + " Stueck"
        trTip += brk and aboveMa ? "\nNeuer Breakout heute ignoriert (Position offen)" : ""
        r := f_row(r, "Trade", trTxt, ok, sz, trTip)
        float nowPct = 100 * (close / tr.entry - 1)
        float nowR = (close - tr.entry) / tr.risk
        r := f_row(r, "Stand", f_sgn(nowPct, "0.0") + " % | " + f_sgn(nowR, "0.0") + " R",
             close >= tr.entry ? ok : bad, sz)
        r := f_row(r, "1R", tr.r1 ? "erreicht" : str.tostring(tr.entry + tr.risk, mt), tr.r1 ? ok : neu, sz)
        string s10Txt = str.tostring(sma10, mt)
        string s20Txt = str.tostring(sma20, mt)
        string nxt = ""
        string nTip = "M2: SL intraday " + str.tostring(tr.stop, mt) + " | vor 1R Close < SMA10 alles"
        nTip += " | ab 1R Close < SMA10 40 % | Close < SMA20 Rest (auch vor 1R)"
        if tr.tp1
            nxt := "C < SMA20 " + s20Txt + " → Rest"
        else if sma20 > sma10
            nxt := "C < SMA20 " + s20Txt + " → 100 %"
        else if tr.r1
            nxt := "C < SMA10 " + s10Txt + " → 40 %"
        else
            nxt := "C < SMA10 " + s10Txt + " → 100 %"
        r := f_row(r, "Exit", nxt, neu, sz, nTip)
        if maWarn
            r := f_row(r, "Warnung", "Kurs < " + maName + " | " + maRule, bad, sz)
    else
        // ----- keine Position -----
        string st = "warte auf Breakout"
        color stC = neu
        bool recentExit = not na(lastExitBar) and bar_index - lastExitBar <= showClosed
        if entryNow or entryPre
            st := entryPre ? "ENTRY? Close abwarten" : "ENTRY"
            stC := ok
        else if brk and aboveMa and why != ""
            st := "gesperrt: " + why
            stC := bad
        else if brk and aboveMa
            st := "Breakout, kein Entry"
        else if recentExit
            st := "geschl. " + str.format_time(lastExitT, "dd.MM.", syminfo.timezone)
            st += " | " + lastExitTag + " " + f_sgn(lastExitR, "0.0") + " R"
            stC := lastExitR >= 0 ? ok : bad
        else if brk
            st := "Breakout < SMA10"
        else if not hasBox
            st := "keine Box"
        else if boxUsed
            st := "Box verbraucht"
        else if boxH > maxBoxAtr
            st := "Box zu hoch"
        string stTip = recentExit ? "Ergebnis " + f_sgn(lastExitP, "0.0") + " %" : ""
        r := f_row(r, "Status", st, stC, sz, stTip)

        string boxTxt = "-"
        if hasBox
            boxTxt := str.tostring(pTop, mt) + " / " + str.tostring(pBot, mt) + " | "
            boxTxt += str.tostring(boxH, "0.0") + " ATR"
        r := f_row(r, "Box", boxTxt, boxValid ? ok : neu, sz)

        // Gates: eine Zeile, Werte im Tooltip (oder ausgeklappt)
        string atrTxt = str.tostring(atrPct, "0.0") + " % (" + str.tostring(atrPctMin, "0.0")
        atrTxt += "-" + str.tostring(atrPctMax, "0.#") + ")"
        string w52Txt = (na(off52) ? "-" : str.tostring(off52, "0") + " %")
        w52Txt += " (" + str.tostring(w52Min, "0.#") + "-" + str.tostring(w52Max, "#") + ")"
        string revTxt = revKnown ? f_sgn(yoy0, "0") + " % vs. " + f_sgn(yoy1, "0") + " %" :
             "keine Daten (" + str.tostring(nq) + " Q)"
        string gTip = "ATR " + atrTxt + "\n52W " + w52Txt + "\nUmsatz YoY " + revTxt
        gTip += "\nUeber SMA10: " + (aboveMa ? "ja" : "nein")
        r := f_row(r, "Gates", why == "" ? "ok" : why, why == "" ? ok : bad, sz, gTip)
        if showGates
            r := f_row(r, "ATR", atrTxt, atrOk ? ok : bad, sz)
            r := f_row(r, "52W", w52Txt, w52Ok ? ok : bad, sz)
            r := f_row(r, "Umsatz", revTxt, revAccel ? ok : revKnown ? bad : neu, sz)

        // ATR-Multiple: Rangfolge bei mehreren Entries am selben Tag (niedrigster zuerst)
        string amTxt = aboveMa and not na(atrMult) ? str.tostring(atrMult, "0.00") : "- (unter SMA10)"
        r := f_row(r, "ATR-Multiple", amTxt, neu, sz, "(Close - SMA10) / ATR. Mehrere Entries am selben Tag: niedrigster Wert zuerst, max. 3")
        float shNow = f_shares(close, sma10)
        if shNow > 0
            string posTxt = str.tostring(shNow, "0.0") + " St | " + str.tostring(shNow * close, "#") + " $"
            string posTip = "Risiko " + str.tostring(shNow * (close - sma10), "#") + " $ (" + riskTxt + ")"
            posTip += " | Deckel " + str.tostring(capPct, "#") + " %"
            r := f_row(r, "Groesse", posTxt, neu, sz, posTip)
            string slTxt = str.tostring(sma10, mt) + " | " + str.tostring(100 * (close - sma10) / close, "0.0") + " %"
            r := f_row(r, "SL", slTxt, neu, sz)

    // Earnings nur bei Bedarf: kurz nach Earnings oder naechste in <= 14 Tagen
    float eDays = na(earnings.future_time) ? na : (earnings.future_time - timenow) / 86400000.0
    bool eSoon = not na(eDays) and eDays <= 14
    if postEarn or eSoon
        string eTxt = postEarn ? "vor " + str.tostring(sinceEarn) + " T" : ""
        eTxt += eSoon ? (postEarn ? " | " : "") + "in " + str.tostring(math.max(math.ceil(eDays), 0), "#") + " T" : ""
        string eTip = postEarn and (brk and aboveMa) ? "Breakout kurz nach Earnings: im Backtest schwach" : ""
        r := f_row(r, "Earnings", eTxt, neu, sz, eTip)

// ---------- Alarme ----------
if msgs.size() > 0
    alert(msgs.join("\n"), alert.freq_once_per_bar_close)
bool touch = boxValid and close[1] <= pTop and high >= pTop
if touch and not entryNow
    string tTxt = syminfo.ticker + " beruehrt Oberkante " + str.tostring(pTop, format.mintick)
    alert(tTxt + (why != "" ? " | gesperrt: " + why : " | Gates ok"), alert.freq_once_per_bar)
if maWarn and not exitNow
    string mTxt = syminfo.ticker + " intraday unter " + maName + " " + str.tostring(maLvl, format.mintick)
    alert(mTxt + " | moeglicher Exit am Close: " + maRule, alert.freq_once_per_bar)
alertcondition(maWarn and not exitNow, "V4.2 Warnung Exit-MA intraday",
     "{{ticker}} intraday unter der Exit-MA (SMA10/SMA20) – Close pruefen")
alertcondition(entryNow, "V4.2 Entry", "System+ V4.2 Entry {{ticker}} {{close}}")
alertcondition(exitNow, "V4.2 Exit komplett", "System+ V4.2 Exit {{ticker}} {{close}}")
alertcondition(touch, "V4.2 Oberkante beruehrt", "{{ticker}} beruehrt die Box-Oberkante")
